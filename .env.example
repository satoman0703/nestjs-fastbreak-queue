# api | worker
APP_TYPE=api
PORT=3000

DATABASE_URL=postgresql://fastbreak:fastbreak@localhost:15432/fastbreak
REDIS_HOST=localhost
REDIS_PORT=16379

# https://app.balldontlie.io で無料登録して取得する
BDL_API_KEY=

# 空なら本物の balldontlie。worker を増やして計測するときは偽物（pnpm fake:bdl）の http://localhost:4010/v1 にする
BDL_API_URL=

# BullMQ が Redis に保存するキー名の頭。テストでは test にして開発用と分ける
BULL_PREFIX=bull
