generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  /// 省略すると tsconfig.json から推測され、tsconfig が無い Docker の build 中は .ts になって起動できなくなる
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// balldontlie のチーム。id は balldontlie の team id をそのまま使う
model Team {
  id           Int    @id
  abbreviation String
  fullName     String
  conference   String
  division     String

  homeGames    Game[] @relation("HomeTeam")
  visitorGames Game[] @relation("VisitorTeam")
}

/// balldontlie の試合。id は balldontlie の game id をそのまま使い、再取り込みしても重複させない
model Game {
  id            Int      @id
  season        Int
  date          DateTime @db.Date
  postseason    Boolean
  status        String
  homeTeamId    Int
  visitorTeamId Int
  homeScore     Int
  visitorScore  Int
  homeQ1        Int?
  homeQ2        Int?
  homeQ3        Int?
  homeQ4        Int?
  homeOt1       Int?
  homeOt2       Int?
  homeOt3       Int?
  visitorQ1     Int?
  visitorQ2     Int?
  visitorQ3     Int?
  visitorQ4     Int?
  visitorOt1    Int?
  visitorOt2    Int?
  visitorOt3    Int?

  homeTeam    Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  visitorTeam Team @relation("VisitorTeam", fields: [visitorTeamId], references: [id])

  @@index([season])
}

enum IngestionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// 取り込みジョブの状態。キューとは別に DB に持ち、API から進捗と結果を返せるようにする
model Ingestion {
  id           String          @id @default(uuid())
  season       Int
  status       IngestionStatus @default(PENDING)
  gamesFetched Int             @default(0)
  /// 次に取るページの cursor。null は 1 ページ目（COMPLETED のときは取るページが残っていない）。
  /// ページの保存と同じトランザクションで進めるので、ジョブの cursor と違えばそのページは保存済み
  cursor       Int?
  error        String?
  /// worker が処理を始めた時刻。createdAt との差がキューでの待ち時間になる
  startedAt    DateTime?
  /// COMPLETED / FAILED になった時刻。startedAt との差が処理時間になる
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum ExportStatus {
  PENDING
  PROCESSING
  /// 全 Batch が終わり、Complete が連結している
  FINALIZING
  COMPLETED
  FAILED
}

/// 試合 CSV のエクスポート。Execute → Batch × batchCount → Complete の進み具合を持つ
model Export {
  id               String       @id @default(uuid())
  /// 対象のシーズン。重複を除いて昇順
  seasons          Int[]
  status           ExportStatus @default(PENDING)
  /// Execute が分けた Batch の数。分ける前は null
  batchCount       Int?
  /// 終わった Batch の数。最後の Batch だけが Complete を積めるよう、+1 した後の値で判定する
  batchesCompleted Int          @default(0)
  /// Complete が連結した CSV。COMPLETED になるまでは null
  csv              String?
  error            String?
  createdAt        DateTime     @default(now())
  finishedAt       DateTime?
  updatedAt        DateTime     @updatedAt

  parts ExportPart[]
}

/// Batch 1 つ分の CSV。api と worker が別コンテナでも読めるよう、ファイルではなく DB に置く
model ExportPart {
  exportId    String
  batchNumber Int
  csv         String

  export Export @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@id([exportId, batchNumber])
}
